---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE_TITLE, SITE_AUTHOR, THEME_BG, withBase } from '../lib/util.js';
import { NAV_LINKS } from '../lib/nav.js';
import { GA_MEASUREMENT_ID } from '../lib/analytics';
// The two faces above-the-fold text uses (same hashed files the CSS loads),
// preloaded so they usually arrive before first paint.
import displayFont from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import uiFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

const {
  title,
  description = 'A personal archive of film, rated in ten parts.',
  // Link-preview image: an absolute URL (e.g. a TMDB backdrop) or a site path.
  image = '/og-image.png',
  imageAlt = `${SITE_TITLE}: a personal archive of film, rated in ten parts`,
  ogType = 'website',
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const absolute = (p) => new URL(p, Astro.site).href;
const pageUrl = absolute(Astro.url.pathname);
const imageUrl = image.startsWith('http') ? image : absolute(withBase(image));

// First-commit year, pinned (CI clones are shallow, so never ask git at build).
const COPYRIGHT_START_YEAR = 2026;
const thisYear = new Date().getFullYear();
const copyrightYears = thisYear > COPYRIGHT_START_YEAR ? `${COPYRIGHT_START_YEAR}-${thisYear}` : `${COPYRIGHT_START_YEAR}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={uiFont} as="font" type="font/woff2" crossorigin />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    <link rel="icon" id="favicon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <meta name="theme-color" id="theme-color" content={THEME_BG.dark} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline define:vars={{ themeBg: THEME_BG }}>
      (function () {
        var colors = { light: '#8a6d3b', dark: '#c9a86a', matrix: '#3aff8f' };
        window.__setFavicon = function (theme) {
          var c = colors[theme] || colors.dark;
          var svg =
            '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">' +
            '<circle cx="16" cy="16" r="14" fill="none" stroke="' + c + '" stroke-width="2.5"/>' +
            '<path d="M13 10.5 L23 16 L13 21.5 Z" fill="' + c + '"/></svg>';
          var link = document.getElementById('favicon');
          if (link) link.href = 'data:image/svg+xml,' + encodeURIComponent(svg);
          // Browser chrome follows the resolved theme, not the OS preference.
          var meta = document.getElementById('theme-color');
          if (meta) meta.content = themeBg[theme] || themeBg.dark;
        };
        try {
          var t = localStorage.getItem('cinema.theme');
          if (t === 'light' || t === 'dark' || t === 'matrix') document.documentElement.dataset.theme = t;
          window.__setFavicon(t || 'dark');
        } catch (e) {}
      })();
    </script>
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>
        // Google tag (gtag.js). Skipped on localhost so `npm run preview` and the
        // QA runs (both serve the production build) never count as visits.
        if (!/^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname)) {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', gaId);
        }
      </script>
    )}
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-row">
          <div class="footer-start">
            <span>{SITE_TITLE}, a personal film archive</span>
            <span class="footer-sep" aria-hidden="true">|</span>
            <nav class="footer-links" aria-label="Footer">
              {NAV_LINKS.filter((l) => !l.href.includes('#')).map((l) => <a href={withBase(l.href)}>{l.label}</a>)}
            </nav>
          </div>
          <span>© {copyrightYears} {SITE_AUTHOR}</span>
        </div>
        <div class="footer-row footer-credits">
          <span>This product uses the TMDB API but is not endorsed or certified by TMDB.</span>
          <a href="https://www.themoviedb.org/" target="_blank" rel="noopener" aria-label="TMDB">
            <img
              class="tmdb-logo"
              src="https://www.themoviedb.org/assets/2/v4/logos/v2/blue_short-8e7b30f73a4020692ccca9c88bafe5dcb6f8a62a4c6bc55cd9ba82bb2cd95f6c.svg"
              alt="TMDB logo"
              loading="lazy"
            />
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
