---
import Base from '../../layouts/Base.astro';
import SortableGrid from '../../components/SortableGrid.svelte';
import { directors, collections, movieById, stillCounts } from '../../lib/data.js';
import { withBase, tmdbImg, fmt1 } from '../../lib/util.js';

export async function getStaticPaths() {
  return directors.map((d) => ({ params: { slug: d.slug }, props: { director: d } }));
}

const { director } = Astro.props;
const collection = director.collectionSlug ? collections.find((c) => c.slug === director.collectionSlug) : null;
const filmographyIds = collection ? collection.movieIds : [];
const filmography = filmographyIds.map((id) => movieById.get(id)).filter(Boolean);
const archiveFilms = director.films.filter((f) => f.movieId != null && movieById.has(f.movieId));
const cards = filmography.length
  ? filmography
  : archiveFilms.map((f) => movieById.get(f.movieId));
const gridFilms = cards.map((m) => ({
  slug: m.slug,
  title: m.title,
  year: m.year,
  poster: m.poster,
  my: m.myRating?.overall ?? null,
  tmdb: m.tmdbRating?.score ?? null,
  imdb: m.omdb?.imdb ?? null,
  stills: stillCounts[m.id] ?? 0,
}));
// TMDB headshot first; Wikipedia/Wikimedia portrait as fallback (compound
// entries like 'Coen Brothers' only exist there).
const portrait = tmdbImg(director.profile, 'w185') ?? director.portraitUrl ?? null;
const bioParas = (director.bio ?? '').split(/\n+/).filter(Boolean).slice(0, 3);
const src = director.sourceAvgs ?? {};
const stats = [
  { id: 'my', label: 'My average', value: director.myAvg != null ? fmt1(director.myAvg) : '–', unit: '/ 10', note: `${director.myCount} rated`, mine: true },
  { id: 'asl', label: 'Average shot length', value: director.aslAvg != null ? `${director.aslAvg}s` : '–', unit: '', note: `${director.aslCount} films measured`, mine: true },
  { id: 'tmdb', label: 'TMDB average', value: src.tmdb ? fmt1(src.tmdb.avg) : '–', unit: '/ 10', note: src.tmdb ? `${src.tmdb.count} films` : 'no data' },
  { id: 'imdb', label: 'IMDb average', value: src.imdb ? fmt1(src.imdb.avg) : '–', unit: '/ 10', note: src.imdb ? `${src.imdb.count} films` : 'no data' },
  { id: 'metacritic', label: 'Metacritic average', value: src.metacritic ? String(Math.round(src.metacritic.avg)) : '–', unit: '/ 100', note: src.metacritic ? `${src.metacritic.count} films` : 'no data' },
];
const tabs = [
  bioParas.length > 0 && { key: 'bio', label: 'Biography' },
  cards.length > 0 && { key: 'films', label: `Films (${cards.length})` },
  director.films.length > 0 && { key: 'asl', label: `Shot length (${director.films.length})` },
].filter(Boolean);
const firstTab = tabs[0]?.key;
---

<Base title={director.name} description={`${director.name}: films, ratings, and average shot length.`}>
  <section class="wrap" style="padding-top:3rem; display:flex; gap:2rem; align-items:flex-start; flex-wrap:wrap;">
    {portrait && <img src={portrait} alt={director.name} width="140" height="210" data-testid="director-portrait" style="border-radius:6px; border:1px solid var(--border); flex-shrink:0; height:auto; max-height:210px; object-fit:cover;" />}
    <div style="flex:1; min-width:280px;">
      <p class="faint small" style="letter-spacing:0.15em; text-transform:uppercase; margin:0;">Hall of fame</p>
      <h1 style="font-size:clamp(2rem, 4.5vw, 3rem);">{director.name}</h1>
      {(director.born || director.died) && (
        <p class="muted small" style="margin-top:-0.3rem;">
          {director.born?.slice(0, 4)}{director.died ? `–${director.died.slice(0, 4)}` : ''}
        </p>
      )}
      {collection && (
        <a class="btn" style="text-decoration:none; margin-top:0.6rem;" href={withBase(`/collection/${collection.slug}`)} data-testid="director-collection">
          Complete filmography · {filmography.length} films →
        </a>
      )}
    </div>
  </section>

  <section class="wrap" style="margin-top:1.6rem;">
    <div class="stat-grid" data-testid="stat-cards">
      {stats.map((st) => (
        <div class="panel" style="padding:0.8rem 1.2rem;" data-testid={`stat-${st.id}`}>
          <div class="faint small">{st.label}</div>
          <div class="score-badge" style={st.mine ? undefined : 'color:var(--ink);'}>{st.value}{st.unit && <> <small>{st.unit}</small></>}</div>
          <div class="faint small">{st.note}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap" style="margin-top:2.4rem;">
    {tabs.length > 1 && (
      <div class="seg" role="tablist" aria-label="Director sections" data-director-tabs style="margin-bottom:1.4rem;">
        {tabs.map((t) => (
          <button class={t.key === firstTab ? 'active' : undefined} role="tab" aria-selected={t.key === firstTab ? 'true' : 'false'} data-tab-btn={t.key} data-testid={`tab-${t.key}`}>
            {t.label}
          </button>
        ))}
      </div>
    )}

    {cards.length > 0 && (
      <div data-tab-panel="films" data-testid="panel-films" hidden={firstTab !== 'films'}>
        <div class="shelf-head">
          <h2>{filmography.length ? 'Filmography' : 'In the archive'}</h2>
          <span class="shelf-note">{cards.length} films</span>
        </div>
        <SortableGrid client:load films={gridFilms} defaultLabel="Chronological" />
      </div>
    )}

    {director.films.length > 0 && (
      <div data-tab-panel="asl" data-testid="panel-asl" hidden={firstTab !== 'asl'}>
        <div class="shelf-head">
          <h2>Shot length ledger</h2>
          <span class="shelf-note">average seconds per shot, film by film</span>
        </div>
        <table class="data-table">
          <thead><tr><th>Film</th><th>Year</th><th>ASL</th><th>My rating</th></tr></thead>
          <tbody>
            {director.films.map((f) => {
              const rec = f.movieId != null ? movieById.get(f.movieId) : null;
              return (
                <tr>
                  <td>{rec ? <a href={withBase(`/movie/${rec.slug}`)}>{f.title}</a> : f.title}</td>
                  <td class="num">{f.year ?? '–'}</td>
                  <td class="num">{f.asl}s</td>
                  <td class="num">{rec?.myRating ? fmt1(rec.myRating.overall) : '–'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}

    {bioParas.length > 0 && (
      <div data-tab-panel="bio" data-testid="panel-bio" hidden={firstTab !== 'bio'}>
        <div class="shelf-head">
          <h2>Biography</h2>
        </div>
        {bioParas.map((p) => <p class="muted" style="max-width:var(--measure);">{p}</p>)}
      </div>
    )}
  </section>
</Base>

<script>
  document.querySelectorAll('[data-director-tabs]').forEach((tabs) => {
    const buttons = tabs.querySelectorAll('[data-tab-btn]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = (btn as HTMLElement).dataset.tabBtn;
        buttons.forEach((b) => {
          b.classList.toggle('active', b === btn);
          b.setAttribute('aria-selected', String(b === btn));
        });
        document.querySelectorAll('[data-tab-panel]').forEach((panel) => {
          (panel as HTMLElement).hidden = (panel as HTMLElement).dataset.tabPanel !== target;
        });
      });
    });
  });
</script>
