---
import Base from '../../../layouts/Base.astro';
import Cup from '../../../components/Cup.svelte';
import { CUPS } from '../../../lib/cups.js';

export function getStaticPaths() {
  return CUPS.map((cup) => ({ params: { slug: cup.slug }, props: { cup } }));
}

const { cup } = Astro.props;
---

<Base
  title={`Dr. X's Cup: ${cup.title}`}
  description={
    cup.description ||
    `A ${cup.size}-film knockout bracket played by Dr. X. Replay it and see how often you agree.`
  }
>
  <section class="wrap page-intro">
    <Cup client:load {cup} />
  </section>
</Base>
