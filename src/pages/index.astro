---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FilmOfDay from '../components/FilmOfDay.astro';
import HomePlay from '../components/HomePlay.astro';
import Shelf from '../components/Shelf.astro';
import MovieCard from '../components/MovieCard.astro';
import ArchiveIntro from '../components/ArchiveIntro.astro';
import { movies, collections, movieById, stillCounts } from '../lib/data.js';
import { withBase } from '../lib/util.js';

const rated = movies.filter((m) => m.myRating);
const topRated = [...rated].sort((a, b) => b.myRating.overall - a.myRating.overall || (b.year ?? 0) - (a.year ?? 0)).slice(0, 16);
const recent = [...rated].sort((a, b) => (b.year ?? 0) - (a.year ?? 0) || b.myRating.overall - a.myRating.overall).slice(0, 16);
const cardProps = (m) => ({ slug: m.slug, title: m.title, year: m.year, poster: m.poster, my: m.myRating?.overall ?? null, stills: stillCounts[m.id] ?? 0 });
---

<Base>
  <Hero />
  <FilmOfDay />
  <HomePlay />

  <section class="wrap">
    <Shelf title="Top of the ledger" note="highest scores on the shelf" rail>
      {topRated.map((m) => <MovieCard {...cardProps(m)} />)}
    </Shelf>
    <Shelf title="Latest screenings" note="most recent releases Dr. X has rated" rail>
      {recent.map((m) => <MovieCard {...cardProps(m)} />)}
    </Shelf>
  </section>

  <ArchiveIntro />

  <section class="wrap" style="margin-top:3rem;">
    <Shelf title="Collections" note="all shelves →" noteHref={withBase('/collections')} label="collections">
      {collections.filter((c) => c.home).map((c, i) => {
        const inArchive = c.movieIds.filter((id) => movieById.has(id)).length;
        return (
          <a class="spine" href={withBase(`/collection/${c.slug}`)}>
            <span class="spine-num">№ {String(i + 1).padStart(2, '0')}</span>
            <span class="spine-title">{c.title}</span>
            <span class="spine-count">{inArchive}</span>
          </a>
        );
      })}
    </Shelf>
  </section>
</Base>
