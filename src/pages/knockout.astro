---
import Base from '../layouts/Base.astro';
import Knockout from '../components/Knockout.svelte';
import { movies, collections } from '../lib/data.js';
import { CUPS } from '../lib/cups.js';

// Menus, bounds and source sizes are known at build time.
const genres = [...new Set(movies.flatMap((m) => m.genres))].sort();
const years = movies.map((m) => m.year).filter(Boolean);
const yearMax = Math.min(Math.max(...years), new Date().getFullYear() + 1);
const counts = { drx: movies.filter((m) => m.myRating).length, archive: movies.length };
const collectionList = collections.map((c) => ({ slug: c.slug, title: c.title, ids: c.movieIds }));
// Each cup's card: its top three seeds' posters, fanned (2, 1, 3).
const cups = CUPS.map((c) => {
  const bySeed = new Map(c.entrants.map((e) => [e.seed, e.poster]));
  return { slug: c.slug, title: c.title, description: c.description, date: c.date, size: c.size, seeding: c.seeding, posters: [2, 1, 3].map((s) => bySeed.get(s) ?? null) };
});
---

<Base title="Knockout" description="Pit films against each other, one matchup at a time, until one is left. Build a bracket from Dr. X's films, the archive or your own lists, or replay Dr. X's Cup.">
  <section class="wrap page-intro">
    <h1>Knockout</h1>
    <p class="muted">Pit films against each other, one matchup at a time, until one is left.</p>
  </section>
  <section class="wrap" style="margin-top:1.6rem; min-height:70vh;">
    <Knockout client:only="svelte" {genres} yearMin={Math.min(...years)} {yearMax} {counts} collections={collectionList} {cups} />
  </section>
</Base>
